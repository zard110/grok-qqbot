{
  "name": "示例群名",
  "aliases": [
    "example"
  ],
  "group_openid": "<GROUP_OPENID_32_HEX>",
  "qq_group_id": null,
  "enabled": true,
  "enabled_plugins": ["command", "kb", "sticker", "ppt_poster", "digest", "reply", "natural_reply"],
  "plugin_bindings": {
    "sticker": {"enabled": true, "config": {}, "quota": {"max_actions_per_day": 50}},
    "ppt_poster": {"enabled": true, "config": {"default_slides": 6, "max_slides": 12}, "quota": {"max_actions_per_day": 20}}
  },
  "quotas": {"max_actions_per_day": 500},
  "features": {
    "natural_reply": true,
    "at_reply": true,
    "daily_ai_news": false,
    "x_info_push": false,
    "image_gen": true,
    "ppt_poster": true,
    "buttons": true,
    "welcome": true,
    "media_understanding": true,
    "knowledge": true
  },
  "style": "本群回复风格，例如：轻量 emoji，【】小标题+编号列表，一次回复合成一条消息。",
  "admins": [
    "<MEMBER_OPENID>"
  ],
  "knowledge": {
    "docs_dir": "knowledge/",
    "repos": [
      {
        "url": "https://github.com/<owner>/<repo>",
        "branch": "main",
        "local_path": "knowledge/repos/<repo>"
      }
    ]
  }
}
