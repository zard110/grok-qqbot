{
  "_comment": "新群自动创建的默认配置模板。机器人首次被拉进群或在群内收到消息时，默认只开启被 @ 礼貌回复；如需开启自然插话、定时资讯或生图等功能，请在该群自己的 config.json 中开启。",
  "enabled": true,
  "enabled_plugins": [
    "command",
    "kb",
    "sticker",
    "digest",
    "reply",
    "natural_reply"
  ],
  "plugin_bindings": {},
  "quotas": {
    "max_actions_per_day": 50000
  },
  "features": {
    "natural_reply": false,
    "at_reply": true,
    "daily_ai_news": false,
    "x_info_push": false,
    "image_gen": false,
    "buttons": false,
    "welcome": false,
    "media_understanding": true,
    "knowledge": true
  },
  "style": "礼貌、简洁，用中文回答；只在被 @ 时回复；不主动推送。",
  "admins": [],
  "knowledge": {
    "docs_dir": "knowledge/",
    "repos": []
  },
  "message_format": {
    "markdown_verified": false,
    "tables_verified": false,
    "fenced_code_verified": false,
    "max_chars": 1000,
    "max_parts": 3,
    "fallback_on_reject": true
  },
  "reply_policy": {
    "inbound_debounce": 0,
    "natural_cooldown": 15,
    "question_cooldown": 0,
    "topic_window": 0,
    "sticker_cooldown": 0,
    "sticker_hourly_limit": 0
  }
}
