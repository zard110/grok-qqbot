# WHITELIST style: ignore everything, then allow only reviewed code/docs.
# Secrets, group configs, chat logs, runtime data, media, NapCat (retired) and backups stay local.
*
!*/
# per-group folders (openid names, configs, chat logs, knowledge repos) never tracked, except the template
/official-bot/groups/*/
!/official-bot/groups/_default/
/official-bot/c2c/
/official-bot/_system/
/official-bot/media/
/forwarder/
/github/

# --- top level ---
!/.gitignore
!/.gitattributes
!/README.md
!/ensure-bots.sh
!/tools/
!/tools/secret-scan.sh
!/tools/check.py

# --- official bot code ---
!/official-bot/official-ws-bridge.py
!/official-bot/send_group.py
!/official-bot/groups.py
!/official-bot/kb.py
!/official-bot/make_sticker.py
!/official-bot/sensenova_make.py
!/official-bot/luckin_coffee.py
!/official-bot/local-watchdog.py
!/official-bot/run-local-watchdog.sh
!/official-bot/run-official-ws.sh
!/official-bot/intents.txt
!/official-bot/tests/intent_probe.py
!/official-bot/tests/test_*.py
!/official-bot/core/*.py
!/official-bot/plugins/*.py
!/official-bot/dashboard.py
!/official-bot/dashboard-static/*.html
!/official-bot/dashboard-static/*.css
!/official-bot/dashboard-static/*.js
!/official-bot/dashboard/*.html
!/official-bot/requirements.txt
!/official-bot/keyboards/*.json

# --- docs ---
!/official-bot/README.md
!/official-bot/USAGE.md
!/official-bot/MULTIGROUP.md
!/official-bot/docs-explore.md
!/official-bot/secrets.example.md
!/official-bot/ARCHITECTURE.md
!/official-bot/MIGRATION.md

# --- sanitized templates (real per-group config.json stays local) ---
!/official-bot/groups/_default/config.json
!/official-bot/groups/_default/prompt.md
!/official-bot/groups/config.example.json

# --- reviewed public sticker pack and reply guidance ---
!/official-bot/install_sticker_pack.py
!/official-bot/REPLY_STYLE.md
!/official-bot/CONVERSATION.md
!/official-bot/assets/openmoji-reactions/*.png
!/official-bot/assets/openmoji-reactions/manifest.json
!/official-bot/assets/openmoji-reactions/LICENSE.txt

# --- safety net: never track these even if whitelisted above by mistake ---
*.bak*
*.log
*.jsonl
*.lock
__pycache__/
*.pyc
*.sqlite3*
*.db*
/official-bot/groups/registry.json
/official-bot/*health*.json
/official-bot/supervisor-*.json
/official-bot/dashboard-session*
/official-bot/*-key
/official-bot/luckin-token
/official-bot/*-token
/official-bot/media/generated/
/official-bot/tools/
