{
  "name": "示例群名",
  "aliases": [
    "example"
  ],
  "group_openid": "<GROUP_OPENID_32_HEX>",
  "qq_group_id": null,
  "enabled": true,
  "enabled_plugins": ["command", "kb", "sticker", "ppt_poster", "luckin_coffee", "amap", "digest", "reply", "natural_reply"],
  "plugin_bindings": {
    "sticker": {"enabled": true, "config": {}, "quota": {"max_actions_per_day": 50}},
    "ppt_poster": {"enabled": true, "config": {"default_slides": 6, "max_slides": 12}, "quota": {"max_actions_per_day": 20}},
    "luckin_coffee": {"enabled": false, "config": {"allow_members": [], "order_members": [], "max_orders_per_member_per_hour": 2,
                      "max_orders_per_group_per_day": 20, "session_minutes": 10, "pay_timeout_minutes": 15, "max_shops": 3}},
    "amap": {"enabled": false, "config": {"default_city": "南京", "allow_members": [], "max_results": 6, "radius": 3000,
             "max_requests_per_member_per_day": 10, "max_requests_per_group_per_day": 200, "midpoint_candidates": 4}}
  },
  "quotas": {"max_actions_per_day": 500},
  "features": {
    "natural_reply": true,
    "at_reply": true,
    "daily_ai_news": false,
    "x_info_push": false,
    "image_gen": true,
    "ppt_poster": true,
    "luckin_coffee": false,
    "amap": false,
    "buttons": true,
    "welcome": true,
    "media_understanding": true,
    "knowledge": true
  },
  "style": "本群回复风格，例如：轻量 emoji，【】小标题+编号列表，一次回复合成一条消息。",
  "reply_policy": {
    "collection_window_seconds": 0,
    "natural_repeat_seconds": 0
  },
  "admins": [
    "<MEMBER_OPENID>"
  ],
  "knowledge": {
    "docs_dir": "knowledge/",
    "repos": [
      {
        "url": "https://github.com/<owner>/<repo>",
        "branch": "main",
        "local_path": "knowledge/repos/<repo>"
      }
    ]
  }
}
